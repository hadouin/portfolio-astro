---
const { title, lastItem, children } = Astro.props;
---

<li class="navbar-dropdown relative group" data-open="false">
  <button
    type="button"
    class="navbar-dropdown-toggle flex items-center gap-1 w-full lg:w-auto lg:px-3 py-2 text-gray-600 hover:text-gray-900"
    aria-haspopup="true"
    aria-expanded="false">
    <span class="scramble-hover font-bold">{title}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="3"
      stroke="currentColor"
      class="w-3 h-3 mt-0.5 transition-transform group-data-[open=true]:rotate-180">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
    </svg>
  </button>
  <div
    class:list={[
      "navbar-dropdown-panel hidden group-data-[open=true]:block lg:absolute w-full lg:w-48 z-10",
      lastItem ? "lg:right-0 origin-top-right" : "lg:left-0 origin-top-left",
    ]}>
    <div
      class="px-3 lg:py-2 lg:bg-white lg:rounded-md lg:shadow lg:border flex flex-col">
      {
        children.map((item) => (
          <a
            href={item.path}
            hreflang={item.hreflang}
            aria-current={item.active ? "true" : undefined}
            class:list={[
              "py-1 hover:text-gray-900",
              item.active ? "text-gray-900 font-semibold" : "text-gray-600",
            ]}>
            {item.title}
          </a>
        ))
      }
    </div>
  </div>
</li>

<script>
  function bindNavbarDropdowns() {
    const dropdowns = document.querySelectorAll<HTMLElement>(".navbar-dropdown");
    dropdowns.forEach((el) => {
      if ((el as any).__navbarDropdownBound) return;
      (el as any).__navbarDropdownBound = true;
      const button = el.querySelector<HTMLButtonElement>(".navbar-dropdown-toggle");
      button?.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = el.dataset.open === "true";
        const next = !open;
        dropdowns.forEach((other) => {
          other.dataset.open = "false";
          other
            .querySelector(".navbar-dropdown-toggle")
            ?.setAttribute("aria-expanded", "false");
        });
        el.dataset.open = String(next);
        button.setAttribute("aria-expanded", String(next));
      });
    });
  }

  function bindOutsideClickOnce() {
    if ((window as any).__navbarDropdownOutsideBound) return;
    (window as any).__navbarDropdownOutsideBound = true;
    document.addEventListener("click", (event) => {
      const target = event.target as Element | null;
      document.querySelectorAll<HTMLElement>(".navbar-dropdown").forEach((el) => {
        if (target && el.contains(target)) return;
        el.dataset.open = "false";
        el.querySelector(".navbar-dropdown-toggle")?.setAttribute(
          "aria-expanded",
          "false"
        );
      });
    });
  }

  bindOutsideClickOnce();
  bindNavbarDropdowns();
  document.addEventListener("astro:page-load", bindNavbarDropdowns);
</script>
