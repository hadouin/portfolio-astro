---
import Link from "@components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import {
  defaultLocale,
  localizedPath,
  stripLocaleFromPath,
  useTranslations,
  type Locale,
} from "@i18n/utils";
import { localeNames, locales } from "@i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const basePath = stripLocaleFromPath(Astro.url.pathname);
const isSignaturePage = basePath === "/signature";
const isHome = basePath === "/";

const home = (anchor: string) =>
  `${localizedPath("/", locale)}${anchor}`;

const menuitems = [
  { title: t("nav.about"), path: home("#about") },
  { title: t("nav.experience"), path: home("#experience") },
  { title: t("nav.projects"), path: home("#projects") },
  { title: t("nav.contact"), path: localizedPath("/contact", locale) },
  { title: t("nav.blog"), path: localizedPath("/blog", locale) },
  {
    title: t("nav.cv"),
    path: "#",
    children: [
      { title: t("nav.cv.en"), path: "/hadouin_leroy-cv-en.pdf" },
      { title: t("nav.cv.fr"), path: "/hadouin_leroy-cv-fr.pdf" },
    ],
  },
];

const switcherChildren = locales.map((loc) => ({
  title: localeNames[loc],
  path: isSignaturePage
    ? loc === defaultLocale
      ? "/signature"
      : `/${loc}`
    : localizedPath(basePath, loc),
  active: loc === locale,
  hreflang: loc,
}));
---

<header
  class="navbar-root group fixed top-0 left-0 right-0 flex flex-col lg:flex-row justify-between items-center bg-white z-50"
  data-home={isHome ? "true" : "false"}
  data-menu-open="false">
  <div class="relative flex h-[70px] w-full items-center justify-between px-5 lg:w-[96px]">
    <a
      href={localizedPath("/", locale)}
      class="navbar-logo absolute bottom-0 left-8 inline-flex h-12 items-end leading-none"
      aria-label="Home"
    >
      <svg
        class="navbar-logo-svg block h-12 w-auto shrink-0"
        viewBox="0 0 158 105"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path
          class="navbar-logo-line navbar-logo-line-blue"
          d="M47.0949 4.69921L55.0806 4.76627L34 104.425H26L47.0949 4.69921Z"
          fill="#8BA6F3"
        />
        <path
          class="navbar-logo-line navbar-logo-line-yellow"
          d="M32.9784 9.63554L40.9467 9.78482L21 104.379H13L32.9784 9.63554Z"
          fill="#F0C477"
        />
        <path
          class="navbar-logo-line navbar-logo-line-red"
          d="M18.9036 14.7126L26.8552 14.9411L8 104.379H0L18.9036 14.7126Z"
          fill="#EE8D8D"
        />
        <path
          class="navbar-logo-h"
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M157.243 0L135.253 104.379H102.212L108.687 73.0938H79.4834L72.9033 104.379H39.8672L61.8574 0H94.8623L85.3584 45.792H114.734L124.238 0H157.243Z"
          fill="currentColor"
        />
      </svg>
    </a>
    <button
      type="button"
      class="navbar-menu-toggle ml-auto block lg:hidden"
      aria-label="Toggle Menu"
      aria-expanded="false"
      aria-controls="navbar-menu">
      <svg
        fill="currentColor"
        class="w-4 h-4 text-gray-800"
        width="24"
        height="24"
        viewBox="0 0 20 20"
        xmlns="http://www.w3.org/2000/svg">
        <title>Toggle Menu</title>
        <path
          class="navbar-menu-icon-open"
          fill-rule="evenodd"
          d="M4 5h16a1 1 0 010 2H4a1 1 0 110-2zm0 6h16a1 1 0 010 2H4a1 1 0 010-2zm0 6h16a1 1 0 010 2H4a1 1 0 010-2z"></path>
        <path
          class="navbar-menu-icon-close"
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M18.278 16.864a1 1 0 01-1.414 1.414l-4.829-4.828-4.828 4.828a1 1 0 01-1.414-1.414l4.828-4.829-4.828-4.828a1 1 0 011.414-1.414l4.829 4.828 4.828-4.828a1 1 0 111.414 1.414l-4.828 4.829 4.828 4.828z"></path>
      </svg>
    </button>
  </div>
  <nav
    id="navbar-menu"
    class="navbar-menu hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0 px-5 pb-5 lg:pb-0 bg-white">
    <ul class="flex flex-col lg:flex-row lg:gap-3 lg:items-center">
      {
        menuitems.map((item) => (
          <>
            {item.children && (
              <Dropdown
                title={item.title}
                children={item.children}
                lastItem={false}
              />
            )}

            {!item.children && (
              <li>
                <a
                  href={item.path}
                  class="scramble-hover font-bold flex lg:px-3 py-2 text-gray-600 hover:text-gray-900">
                  {item.title}
                </a>
              </li>
            )}
          </>
        ))
      }
      <li
        class="navbar-dropdown relative group"
        data-open="false"
        data-lang-switcher
        data-current-locale={locale}>
        <button
          type="button"
          class="navbar-dropdown-toggle relative flex items-center gap-1 w-full lg:w-auto lg:px-3 py-2 text-gray-600 hover:text-gray-900"
          aria-haspopup="true"
          aria-expanded="false">
          <span class="scramble-hover font-bold">{locale.toUpperCase()}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="3"
            stroke="currentColor"
            class="w-3 h-3 mt-0.5 transition-transform group-data-[open=true]:rotate-180">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
          </svg>
          <span
            data-lang-puck
            class="hidden absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-red-500 ring-2 ring-white pointer-events-none"
            aria-hidden="true"
          ></span>
        </button>
        <div
          class="navbar-dropdown-panel hidden group-data-[open=true]:block lg:absolute lg:right-0 origin-top-right w-full lg:w-48 z-10">
          <div
            class="px-3 lg:py-2 lg:bg-white lg:rounded-md lg:shadow lg:border flex flex-col">
            {
              switcherChildren.map((item) => (
                <a
                  href={item.path}
                  hreflang={item.hreflang}
                  aria-current={item.active ? "true" : undefined}
                  class:list={[
                    "py-1 hover:text-gray-900",
                    item.active ? "text-gray-900 font-semibold" : "text-gray-600",
                  ]}>
                  {item.title}
                </a>
              ))
            }
          </div>
        </div>
      </li>
    </ul>
    <div class="lg:hidden flex items-center mt-3 gap-4">
      <Link href={localizedPath("/contact", locale)} size="md" block>{t("nav.hireMe")}</Link>
    </div>
  </nav>
</header>

<style>
  :global(body.hero-dark-active .navbar-root[data-home="true"]) {
    background: transparent;
    color: #ffffff;
  }

  :global(body.hero-dark-active .navbar-root[data-home="true"] .navbar-menu) {
    background: transparent;
  }

  :global(body.hero-dark-active .navbar-root[data-home="true"] a),
  :global(body.hero-dark-active .navbar-root[data-home="true"] button),
  :global(body.hero-dark-active .navbar-root[data-home="true"] .navbar-menu-toggle svg),
  :global(body.hero-dark-active .navbar-root[data-home="true"] .navbar-dropdown-toggle svg) {
    color: #ffffff !important;
  }

  .navbar-logo-svg {
    color: #1f2937;
    overflow: visible;
  }

  .navbar-logo-line {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    transition:
      transform 200ms ease-out,
      opacity 200ms ease-out;
  }

  .navbar-logo-line-blue {
    transform: translateX(14px);
    transition-delay: 100ms;
  }

  .navbar-logo-line-yellow {
    transform: translateX(14px);
    transition-delay: 50ms;
  }

  .navbar-logo-line-red {
    transform: translateX(14px);
    transition-delay: 0ms;
  }

  .navbar-logo-h {
    transform-box: fill-box;
    transform-origin: center;
    transform: translate3d(-5px, 1px, 0);
    transition: transform 200ms ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .navbar-logo:hover .navbar-logo-h {
      transform: none;
    }

    .navbar-logo:hover .navbar-logo-line {
      opacity: 1;
      transform: none;
    }

    .navbar-logo:hover .navbar-logo-line-blue {
      transition-delay: 0ms;
    }

    .navbar-logo:hover .navbar-logo-line-yellow {
      transition-delay: 50ms;
    }

    .navbar-logo:hover .navbar-logo-line-red {
      transition-delay: 100ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-logo-h,
    .navbar-logo-line {
      transition: none;
    }

    .navbar-logo-h {
      transform: none;
    }

    .navbar-logo-line {
      opacity: 1;
      transform: none;
    }
  }

  :global(body.hero-dark-active .navbar-root[data-home="true"] .navbar-logo-svg) {
    color: #ffffff;
  }

  :global(body.hero-dark-active .navbar-root[data-home="true"] .navbar-dropdown-panel a) {
    color: #ffffff !important;
  }

  :global(body.hero-dark-active .navbar-root[data-home="true"] .navbar-dropdown-panel > div) {
    border-color: #333331;
    background: #222220;
  }

  :global(body.hero-dark-active .navbar-root[data-home="true"] [data-lang-puck]) {
    --tw-ring-color: transparent;
  }

  @media (max-width: 1023px) {
    :global(body.hero-dark-active .navbar-root[data-home="true"][data-menu-open="true"]) {
      background: #1a1a19;
    }

    :global(
      body.hero-dark-active .navbar-root[data-home="true"][data-menu-open="true"] .navbar-menu
    ) {
      background: #1a1a19;
    }
  }

  .navbar-root .navbar-menu-icon-close {
    display: none;
  }
  .navbar-root[data-menu-open="true"] .navbar-menu-icon-open {
    display: none;
  }
  .navbar-root[data-menu-open="true"] .navbar-menu-icon-close {
    display: block;
  }
  @media (max-width: 1023px) {
    .navbar-root[data-menu-open="true"] .navbar-menu {
      display: block;
    }
  }
</style>

<script>
  function bindNavbarMenu() {
    document.querySelectorAll<HTMLElement>(".navbar-root").forEach((header) => {
      if ((header as any).__navbarMenuBound) return;
      (header as any).__navbarMenuBound = true;
      const toggle = header.querySelector<HTMLButtonElement>(
        ".navbar-menu-toggle"
      );
      toggle?.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = header.dataset.menuOpen === "true";
        const next = !open;
        header.dataset.menuOpen = String(next);
        toggle.setAttribute("aria-expanded", String(next));
      });
      header.querySelectorAll<HTMLAnchorElement>("nav a").forEach((a) => {
        a.addEventListener("click", () => {
          header.dataset.menuOpen = "false";
          toggle?.setAttribute("aria-expanded", "false");
        });
      });
    });
  }

  function bindNavbarHashLinks() {
    if ((window as any).__navbarHashBound) return;
    (window as any).__navbarHashBound = true;
    document.addEventListener(
      "click",
      (event) => {
        const anchor = (event.target as Element | null)?.closest(
          "header a[href*='#']"
        ) as HTMLAnchorElement | null;
        if (!anchor) return;
        const url = new URL(anchor.href, location.href);
        if (url.pathname !== location.pathname) return;
        if (!url.hash || url.hash === "#") return;
        const target = document.querySelector(url.hash) as HTMLElement | null;
        if (!target) return;
        event.preventDefault();
        event.stopPropagation();
        const lenis = (window as any).lenis;
        if (lenis?.scrollTo) {
          lenis.scrollTo(target, { force: true });
        } else {
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        }
        history.replaceState(null, "", url.hash);
      },
      true
    );
  }

  function syncLangPuck() {
    document
      .querySelectorAll<HTMLElement>("[data-lang-switcher]")
      .forEach((switcher) => {
        const puck = switcher.querySelector<HTMLElement>("[data-lang-puck]");
        if (!puck) return;
        const current = switcher.dataset.currentLocale;
        const dismissed = localStorage.getItem("hadouin:lang-puck-dismissed");
        const navLang = (navigator.language || "").toLowerCase();
        const navIsFr = navLang.startsWith("fr");
        const shouldShow =
          current === "en" && navIsFr && dismissed !== "1";
        puck.classList.toggle("hidden", !shouldShow);

        if (!(switcher as any).__puckBound) {
          (switcher as any).__puckBound = true;
          switcher.addEventListener(
            "click",
            () => {
              localStorage.setItem("hadouin:lang-puck-dismissed", "1");
              puck.classList.add("hidden");
            },
            { capture: true },
          );
        }
      });
  }

  bindNavbarHashLinks();
  bindNavbarMenu();
  syncLangPuck();
  document.addEventListener("astro:page-load", bindNavbarMenu);
  document.addEventListener("astro:page-load", syncLangPuck);
</script>
