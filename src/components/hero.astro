---
import Link from "@components/ui/link.astro";
import { localizedPath, useTranslations, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const displayName = "Hadouin";
const controlsCopy = locale === "fr"
  ? {
      status: "IDÉE PRÊTE",
      grab: "Attraper une idée",
      hint: "Glisser pour faire pivoter",
      canvas: "Une machine à idées interactive en trois dimensions",
      controls: "Commandes de la machine à idées",
      directions: ["Reculer la pince", "Déplacer la pince à gauche", "Avancer la pince", "Déplacer la pince à droite"],
    }
  : {
      status: "IDEA READY",
      grab: "Grab an idea",
      hint: "Drag to rotate",
      canvas: "An interactive three-dimensional idea claw machine",
      controls: "Idea machine controls",
      directions: ["Move claw back", "Move claw left", "Move claw forward", "Move claw right"],
    };
---

<section
  class="hero-shell relative isolate z-30 -mt-[70px] min-h-[100svh] overflow-hidden"
  data-dark-hero
>
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-layout">
    <div class="machine-column">
      <div class="machine-stage" data-idea-machine>
        <canvas
          class="machine-canvas"
          data-machine-canvas
          aria-label={controlsCopy.canvas}
          role="img"
        ></canvas>
        <div class="machine-fallback">
          <span>IDEA</span>
          <small>3D MACHINE</small>
        </div>
        <div class="machine-reflection" aria-hidden="true"></div>
      </div>

      <div class="machine-console" role="group" aria-label={controlsCopy.controls}>
        <div class="machine-dpad">
          <button type="button" data-machine-move="0,-0.28" aria-label={controlsCopy.directions[0]}>▲</button>
          <button type="button" data-machine-move="-0.3,0" aria-label={controlsCopy.directions[1]}>◀</button>
          <button type="button" data-machine-move="0,0.28" aria-label={controlsCopy.directions[2]}>▼</button>
          <button type="button" data-machine-move="0.3,0" aria-label={controlsCopy.directions[3]}>▶</button>
        </div>
        <div class="machine-readout">
          <span class="machine-status" data-machine-status aria-live="polite">{controlsCopy.status}</span>
          <span class="machine-hint">{controlsCopy.hint}</span>
        </div>
        <button class="machine-grab" type="button" data-machine-grab>{controlsCopy.grab}</button>
      </div>
    </div>

    <div class="hero-content">
      <p class="hero-kicker">{t("hero.greeting")}</p>
      <h1 aria-label="Hadouin Leroy">
        <span class="sr-only">Hadouin Leroy</span>
        <span class="hacker-effect" data-value={displayName} aria-hidden="true">{displayName}</span>
      </h1>
      <p class="hero-tagline">{t("hero.tagline")}</p>
      <p class="hero-intro">{t("hero.intro")}</p>
      <Link
        class="hire-me wiggle w-fit font-semibold"
        style="inverted"
        href={localizedPath("/contact", locale)}
      >
        {t("nav.hireMe")}
      </Link>
    </div>
  </div>

  <div class="hero-grain" aria-hidden="true"></div>
</section>

<style>
  .hero-shell {
    --paper: #f2e8d7;
    --ink: #191817;
    --muted: #bdb8ad;
    --red: #eb6657;
    --yellow: #efbb40;
    --blue: #718bda;
    color: var(--paper);
    background:
      radial-gradient(circle at 26% 42%, rgb(235 102 87 / 0.13), transparent 24%),
      radial-gradient(circle at 46% 30%, rgb(239 187 64 / 0.1), transparent 28%),
      #1a1917;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    background-image:
      linear-gradient(rgb(242 232 215 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, rgb(242 232 215 / 0.12) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(circle at 26% 45%, black, transparent 62%);
  }

  .hero-layout {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: 100svh;
    max-width: 1536px;
    margin: 0 auto;
    padding: 86px 1rem 2rem;
    grid-template-rows: minmax(24rem, 56svh) auto;
    align-items: center;
  }

  .machine-column {
    position: relative;
    width: min(100%, 45rem);
    height: 100%;
    min-height: 24rem;
    margin-inline: auto;
  }

  .machine-stage {
    position: absolute;
    inset: -2rem -1.5rem 1.75rem;
    opacity: 0;
    transform: translateY(18px) scale(0.98);
    transition: opacity 700ms ease, transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .machine-stage[data-ready="true"],
  .machine-stage[data-webgl-failed="true"] {
    opacity: 1;
    transform: none;
  }

  .machine-stage::before {
    position: absolute;
    inset: 8% 9% 6%;
    content: "";
    border-radius: 50%;
    background: rgb(236 171 96 / 0.19);
    filter: blur(60px);
  }

  .machine-canvas {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: pan-y;
  }

  .machine-canvas:active { cursor: grabbing; }

  .machine-fallback {
    position: absolute;
    inset: 25% 18%;
    display: none;
    place-items: center;
    border: 12px solid var(--paper);
    color: var(--paper);
    font-weight: 900;
    font-size: clamp(4rem, 18vw, 8rem);
  }

  .machine-fallback small {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.26em;
  }

  [data-webgl-failed="true"] .machine-canvas { display: none; }
  [data-webgl-failed="true"] .machine-fallback { display: grid; }

  .machine-reflection {
    position: absolute;
    z-index: 1;
    right: 17%;
    bottom: 4%;
    left: 14%;
    height: 12%;
    border-radius: 50%;
    background: #090908;
    filter: blur(26px);
    opacity: 0.64;
    transform: perspective(600px) rotateX(68deg);
  }

  .machine-console {
    position: absolute;
    z-index: 4;
    right: 0.5rem;
    bottom: 1rem;
    left: 0.5rem;
    display: grid;
    grid-template-columns: auto minmax(8rem, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    max-width: 34rem;
    margin-inline: auto;
    padding: 0.55rem;
    border: 1px solid rgb(242 232 215 / 0.23);
    background: rgb(18 17 16 / 0.84);
    box-shadow: 0 15px 40px rgb(0 0 0 / 0.25);
    backdrop-filter: blur(12px);
  }

  .machine-dpad {
    display: grid;
    grid-template-columns: repeat(3, 1.6rem);
    grid-template-rows: repeat(2, 1.5rem);
  }

  .machine-dpad button,
  .machine-grab {
    border: 0;
    color: var(--paper);
    background: #302e2b;
    transition: transform 140ms ease, background 140ms ease;
  }

  .machine-dpad button:hover { background: #46423d; }
  .machine-dpad button:active, .machine-grab:active { transform: translateY(2px); }
  .machine-dpad button:focus-visible, .machine-grab:focus-visible {
    outline: 2px solid var(--yellow);
    outline-offset: 2px;
  }

  .machine-dpad button:nth-child(1) { grid-column: 2; }
  .machine-dpad button:nth-child(2) { grid-column: 1; grid-row: 2; }
  .machine-dpad button:nth-child(3) { grid-column: 2; grid-row: 2; }
  .machine-dpad button:nth-child(4) { grid-column: 3; grid-row: 2; }

  .machine-readout {
    min-width: 0;
    padding-inline: 0.35rem;
    line-height: 1;
  }

  .machine-status {
    display: block;
    overflow: hidden;
    color: #d3e95b;
    font-family: monospace;
    font-size: 0.67rem;
    letter-spacing: 0.08em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .machine-hint {
    display: block;
    margin-top: 0.35rem;
    color: #8d8981;
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .machine-grab {
    min-height: 2.65rem;
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    color: #fff6e7;
    background: var(--red);
    box-shadow: inset 0 -4px 0 rgb(89 21 15 / 0.35), 0 0 0 4px #292725;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    padding: 1rem 0 2rem;
  }

  .hero-kicker {
    margin-bottom: 0.75rem;
    color: #c7c1b6;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(3.25rem, 12vw, 7rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: 0.02em;
  }

  .hacker-effect {
    display: block;
    min-height: 0.95em;
    white-space: pre;
  }

  .hero-tagline {
    max-width: 42rem;
    margin-top: 0.5rem;
    color: #aaa69e;
    font-size: clamp(2rem, 7vw, 4.4rem);
    font-weight: 700;
    line-height: 0.97;
    text-wrap: balance;
  }

  .hero-intro {
    max-width: 38rem;
    margin-block: 1.5rem;
    color: #ddd7cb;
    font-family: Inter, sans-serif;
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.68;
  }

  .hero-grain {
    pointer-events: none;
    position: absolute;
    z-index: 5;
    inset: 0;
    opacity: 0.045;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  @media (min-width: 768px) {
    .hero-layout {
      grid-template-columns: minmax(0, 1.06fr) minmax(22rem, 0.94fr);
      grid-template-rows: 1fr;
      gap: clamp(0rem, 2vw, 2.5rem);
      padding: 70px 1.5rem 0;
    }

    .machine-column {
      width: 100%;
      min-height: min(47rem, calc(100svh - 70px));
    }

    .machine-stage { inset: -1rem -9% 1rem -12%; }
    .machine-console { bottom: 2.25rem; }
    .hero-content { padding: 0 clamp(0rem, 2vw, 2.25rem) 0 0; }
    .hero-kicker { font-size: 0.88rem; }
  }

  @media (min-width: 1200px) {
    .hero-layout { grid-template-columns: minmax(0, 1.12fr) minmax(29rem, 0.88fr); }
    .machine-stage { inset: -3rem -5% -1rem -8%; }
    .machine-console { bottom: 1.5rem; }
  }

  @media (max-width: 430px) {
    .hero-layout { grid-template-rows: minmax(21rem, 52svh) auto; }
    .machine-column { min-height: 21rem; }
    .machine-stage { inset-inline: -2.75rem; }
    .machine-console { gap: 0.45rem; }
    .machine-hint { display: none; }
    .machine-grab { max-width: 5.5rem; padding-inline: 0.55rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .machine-stage { transition: none; }
    .machine-dpad button, .machine-grab { transition: none; }
  }
</style>

<script>
  import { initIdeaMachine3D } from "../lib/idea-machine-3d";

  const letters = "abcdefgHijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ?@:/}{()*+-#$&";
  const scrambleColors = ["#8BA6F3", "#F0C477", "#EE8D8D"];
  const randomScrambleColor = () =>
    scrambleColors[Math.floor(Math.random() * scrambleColors.length)];

  function setScrambledContent(element: HTMLElement, target: string, iteration: number) {
    element.replaceChildren();
    for (let index = 0; index < target.length; index++) {
      const ch = target[index];
      if (index < iteration) {
        element.appendChild(document.createTextNode(ch));
        continue;
      }
      const span = document.createElement("span");
      span.style.color = randomScrambleColor();
      span.textContent = letters[Math.floor(Math.random() * letters.length)];
      element.appendChild(span);
    }
  }

  function initHero() {
    const element = document.querySelector(".hacker-effect") as HTMLElement | null;
    if (!element || (element as any).__heroBound) return;
    (element as any).__heroBound = true;
    const target = element.dataset.value ?? "Hadouin";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let interval: ReturnType<typeof setInterval> | undefined;

    const scramble = () => {
      if (reduceMotion) {
        element.textContent = target;
        return;
      }
      if (interval) clearInterval(interval);
      let iteration = 0;
      interval = setInterval(() => {
        setScrambledContent(element, target, iteration);
        if (iteration >= target.length) {
          if (interval) clearInterval(interval);
          element.textContent = target;
        }
        iteration += 1 / 3;
      }, 30);
    };

    element.addEventListener("mouseenter", scramble);
    scramble();
  }

  function initMachine() {
    const previousCleanup = (window as any).__ideaMachineCleanup as (() => void) | undefined;
    previousCleanup?.();

    const container = document.querySelector<HTMLElement>("[data-idea-machine]");
    const canvas = container?.querySelector<HTMLCanvasElement>("[data-machine-canvas]");
    const status = document.querySelector<HTMLElement>("[data-machine-status]");
    if (!container || !canvas) return;

    const controller = initIdeaMachine3D({ container, canvas, status });
    if (!controller) return;
    (window as any).__ideaMachineCleanup = controller.dispose;
    (window as any).__ideaMachineController = controller;

    document.querySelectorAll<HTMLButtonElement>("[data-machine-move]").forEach((button) => {
      if ((button as any).__machineBound) return;
      (button as any).__machineBound = true;
      button.addEventListener("click", () => {
        const [dx, dz] = (button.dataset.machineMove ?? "0,0").split(",").map(Number);
        (window as any).__ideaMachineController?.move(dx, dz);
      });
    });
    const grabButton = document.querySelector<HTMLButtonElement>("[data-machine-grab]");
    if (grabButton && !(grabButton as any).__machineBound) {
      (grabButton as any).__machineBound = true;
      grabButton.addEventListener("click", () => (window as any).__ideaMachineController?.grab());
    }
  }

  function syncHeroTheme() {
    const hero = document.querySelector<HTMLElement>("[data-dark-hero]");
    const previous = (window as any).__heroThemeObserver as IntersectionObserver | undefined;
    previous?.disconnect();
    if (!hero) {
      document.body.classList.remove("hero-dark-active");
      return;
    }

    const updateTheme = () => {
      const rect = hero.getBoundingClientRect();
      document.body.classList.toggle("hero-dark-active", rect.bottom > 70 && rect.top < window.innerHeight);
    };
    const observer = new IntersectionObserver(updateTheme, { rootMargin: "-70px 0px 0px", threshold: 0 });
    observer.observe(hero);
    (window as any).__heroThemeObserver = observer;
    updateTheme();
  }

  function init() {
    initHero();
    initMachine();
    syncHeroTheme();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
