---
import { Image, getImage } from "astro:assets";
import Link from "@components/ui/link.astro";
import { localizedPath, useTranslations, type Locale } from "@i18n/utils";
import heroPortrait from "@assets/hadouin-hero.jpg";
import heroEdges from "@assets/hadouin-hero-edges.webp";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const displayName = "Hadouin";
const heroTexture = await getImage({ src: heroPortrait, width: 1600, quality: 75, format: "webp" });
---

<section
  class="hero-shell relative isolate z-30 -mt-[70px] min-h-[100svh] overflow-hidden"
  data-dark-hero
>
  <div
    class="hero-portrait absolute inset-x-0 top-0 h-[56%] md:inset-y-0 md:left-0 md:right-auto md:h-auto md:w-[58%]"
    data-chromatic-portrait
    data-image-src={heroTexture.src}
    data-edge-src={heroEdges.src}
    data-image-width={heroPortrait.width}
    data-image-height={heroPortrait.height}
  >
    <Image
      src={heroPortrait}
      alt={t("about.image.alt")}
      widths={[720, 1080, 1440, 1600]}
      sizes="(min-width: 768px) 58vw, 100vw"
      quality={68}
      loading="eager"
      fetchpriority="high"
      class="hero-portrait-image hero-portrait-base"
    />
    <canvas class="hero-chromatic-canvas" aria-hidden="true"></canvas>
  </div>

  <div
    class="hero-content relative z-10 mx-auto flex min-h-[100svh] w-full max-w-screen-2xl items-end px-4 pb-12 pt-[48vh] md:items-center md:justify-end md:px-6 md:pb-16 md:pt-[70px] lg:px-8"
  >
    <div class="w-full md:w-[56%] md:max-w-[50rem] lg:w-[54%]">
      <p class="hero-kicker mb-3 text-sm font-semibold uppercase tracking-[0.24em] md:text-base">
        {t("hero.greeting")}
      </p>
      <h1
        class="text-5xl font-bold tracking-wide sm:text-6xl lg:text-7xl xl:text-8xl"
        aria-label="Hadouin Leroy"
      >
        <span class="sr-only">Hadouin Leroy</span>
        <span
          class="hacker-effect block h-[48px] whitespace-pre sm:h-[60px] lg:h-[72px] xl:h-[96px]"
          data-value={displayName}
          aria-hidden="true"
        >
          {displayName}
        </span>
      </h1>
      <p class="hero-tagline mt-2 max-w-3xl text-3xl font-bold leading-[0.98] sm:text-4xl lg:text-5xl xl:text-6xl">
        {t("hero.tagline")}
      </p>
      <p class="hero-intro my-6 max-w-2xl font-inter text-base leading-relaxed sm:text-lg">
        {t("hero.intro")}
      </p>
      <Link
        class="w-fit font-semibold"
        style="inverted"
        href={`${localizedPath("/", locale)}#about`}
        data-door-open
      >
        {t("hero.cta")}
      </Link>
    </div>
  </div>

  <div class="hero-grain pointer-events-none absolute inset-0 z-20" aria-hidden="true"></div>

  <div class="hero-door-hint" data-door-hint aria-hidden="true">
    <span class="hero-door-chevrons"><i></i><i></i></span>
    <span class="hero-door-label">{t("door.hint")}</span>
    <span class="hero-door-meter"><span class="hero-door-meter-fill"></span></span>
  </div>

  <div class="hero-door-lip" aria-hidden="true"></div>
</section>

<div class="hero-door-fx" data-door-fx aria-hidden="true">
  <div class="hero-door-steam" data-door-steam></div>
</div>

<style>
  .hero-shell {
    background: #1a1a19;
    color: #f4f4f0;
    --door-y: 0;
    --gate: 0;
    --arm: 0;
  }

  /* ---------------- shutter gate ---------------- */

  /* Lifted out of flow so the content below sits underneath it, ready to be
     revealed. Only ever applied by the gate script. */
  .hero-shell.is-gated {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    margin-top: 0;
    height: 100svh;
    min-height: 0;
    transform: translate3d(
      var(--shake-x, 0px),
      calc(var(--door-y) * 1% + var(--shake-y, 0px)),
      0
    );
    will-change: transform;
  }

  .hero-shell.is-open {
    visibility: hidden;
    pointer-events: none;
  }

  /* Fade the copy out once the shutter is clearly on its way up, so it never
     collides with the navbar on the way past. Peeking keeps it fully legible. */
  .hero-shell.is-gated .hero-content,
  .hero-shell.is-gated .hero-door-hint {
    opacity: clamp(0, calc((var(--door-y) + 52) / 28), 1);
  }

  /* The bottom edge of the shutter: a lip that only shows itself once the
     door starts to move. */
  .hero-door-lip {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 25;
    height: 8px;
    opacity: 0;
    background: repeating-linear-gradient(
      -45deg,
      #f0c477 0 14px,
      #17171a 14px 28px
    );
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.75);
    pointer-events: none;
  }

  .hero-shell.is-gated .hero-door-lip {
    opacity: clamp(0, calc(var(--arm) * 1.6), 1);
  }

  /* ---------------- scroll-to-open indicator ---------------- */

  .hero-door-hint {
    position: absolute;
    inset: auto 0 clamp(1.25rem, 3.5vh, 2.5rem) 0;
    z-index: 25;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    pointer-events: none;
  }

  .hero-shell.is-gated .hero-door-hint {
    display: flex;
  }

  .hero-shell.is-open .hero-door-hint {
    opacity: 0;
  }

  /* Mobile stacks the copy against the bottom edge, so make room for the
     indicator sitting below it. */
  @media (max-width: 767px) {
    .hero-shell.is-gated .hero-content {
      padding-bottom: 7.5rem;
    }
  }

  .hero-door-chevrons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .hero-door-chevrons i {
    width: 14px;
    height: 14px;
    border-right: 1.5px solid rgb(244 244 240 / 0.75);
    border-bottom: 1.5px solid rgb(244 244 240 / 0.75);
    transform: rotate(45deg);
    animation: heroDoorChevron 1.7s ease-in-out infinite;
  }

  .hero-door-chevrons i:last-child {
    animation-delay: 0.18s;
    opacity: 0.55;
  }

  @keyframes heroDoorChevron {
    0%,
    100% {
      transform: translateY(-3px) rotate(45deg);
      opacity: 0.35;
    }
    50% {
      transform: translateY(3px) rotate(45deg);
      opacity: 1;
    }
  }

  .hero-door-label {
    font-size: 0.7rem;
    letter-spacing: 0.34em;
    text-indent: 0.34em;
    text-transform: uppercase;
    color: rgb(244 244 240 / 0.72);
  }

  /* Fills as the shutter is pushed; goes gold once it will latch open. */
  .hero-door-meter {
    position: relative;
    width: clamp(90px, 16vw, 150px);
    height: 2px;
    overflow: hidden;
    background: rgb(244 244 240 / 0.16);
  }

  .hero-door-meter-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--arm) * 100%);
    background: rgb(244 244 240 / 0.65);
  }

  .hero-shell.is-armed .hero-door-meter-fill {
    background: #f0c477;
    box-shadow: 0 0 10px rgb(240 196 119 / 0.85);
  }

  .hero-shell.is-armed .hero-door-label {
    color: #f0c477;
  }

  /* ---------------- hydraulic steam ---------------- */

  .hero-door-fx {
    position: fixed;
    inset: 0;
    /* Above the shutter (40) but under the navbar (50): the vent fires while
       the door still covers the viewport, so it has to read in front of it. */
    z-index: 41;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-door-steam {
    position: absolute;
    inset: 0;
  }

  /* Vapour, not smoke: bright and near-white, blown out under pressure and
     gone almost as fast. The animation snaps open then trails off. */
  .hero-door-steam :global(.hero-steam) {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      rgb(255 255 255 / 0.95) 0%,
      rgb(244 248 252 / 0.5) 34%,
      rgb(226 236 246 / 0) 68%
    );
    filter: blur(7px);
    opacity: 0;
    animation: heroSteam var(--d, 400ms) cubic-bezier(0.08, 0.82, 0.17, 1)
      forwards;
  }

  @keyframes heroSteam {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) scale(calc(var(--s) * 0.16));
    }
    10% {
      opacity: 0.95;
    }
    58% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--dx), var(--dy), 0) scale(var(--s));
    }
  }

  .hero-portrait {
    isolation: isolate;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 70%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 70%, transparent 100%);
  }

  .hero-portrait-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 43%;
  }

  .hero-portrait-base {
    z-index: 0;
  }

  .hero-chromatic-canvas {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
  }

  .hero-portrait[data-chromatic-ready="true"] .hero-chromatic-canvas {
    opacity: 1;
  }

  .hero-portrait[data-chromatic-ready="true"] .hero-portrait-base {
    visibility: hidden;
  }

  .hero-portrait::after {
    position: absolute;
    z-index: 2;
    inset: 0;
    content: "";
    background:
      linear-gradient(to bottom, transparent 48%, #1a1a19 100%),
      linear-gradient(to right, transparent 62%, rgb(26 26 25 / 0.42) 100%);
    pointer-events: none;
  }

  .hero-kicker {
    color: #c7c7c0;
  }

  .hero-tagline {
    color: #a8a8a2;
    text-wrap: balance;
  }

  .hero-intro {
    color: #deded8;
  }

  .hero-grain {
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  @media (min-width: 768px) {
    .hero-portrait {
      -webkit-mask-image: linear-gradient(to right, #000 0%, #000 58%, transparent 100%);
      mask-image: linear-gradient(to right, #000 0%, #000 58%, transparent 100%);
    }

    .hero-portrait::after {
      background:
        linear-gradient(to right, transparent 54%, #1a1a19 100%),
        linear-gradient(to top, rgb(26 26 25 / 0.18), transparent 38%);
    }

    .hero-portrait-image {
      object-position: 50% 48%;
    }
  }

  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .hero-chromatic-canvas {
      display: none;
    }
  }
</style>

<script>
  import { initHeroChromaticWebGL } from "../lib/hero-chromatic-webgl";
  import { initHeroDoorGate } from "../lib/hero-door-gate";

  const letters = "abcdefgHijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ?@:/}{()*+-#$&?@:/}{()*+-#$&";
  const scrambleColors = ["#8BA6F3", "#F0C477", "#EE8D8D"];
  const randomScrambleColor = () =>
    scrambleColors[Math.floor(Math.random() * scrambleColors.length)];

  function setScrambledContent(element: HTMLElement, target: string, iteration: number) {
    element.replaceChildren();
    for (let index = 0; index < target.length; index++) {
      const ch = target[index];
      if (index < iteration) {
        element.appendChild(document.createTextNode(ch));
        continue;
      }
      const span = document.createElement("span");
      span.style.color = randomScrambleColor();
      span.textContent = letters[Math.floor(Math.random() * letters.length)];
      element.appendChild(span);
    }
  }

  function initHero() {
    const element = document.querySelector(".hacker-effect") as HTMLElement | null;
    if (!element) return;
    if ((element as any).__heroBound) return;
    (element as any).__heroBound = true;

    const target = element.dataset.value ?? "Hadouin";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let interval: ReturnType<typeof setInterval> | undefined;

    const scramble = () => {
      if (reduceMotion) {
        element.textContent = target;
        return;
      }

      if (interval) clearInterval(interval);
      let iteration = 0;
      interval = setInterval(() => {
        setScrambledContent(element, target, iteration);

        if (iteration >= target.length) {
          if (interval) clearInterval(interval);
          element.textContent = target;
        }
        iteration += 1 / 3;
      }, 30);
    };

    element.addEventListener("mouseenter", scramble);
    // Fired by the door gate the moment the shutter breaks loose. Listening on
    // the element itself means the handler dies with it on a page swap.
    element.addEventListener("hero:opening", scramble);
    scramble();
  }

  function initChromaticPortrait() {
    const previousCleanup = (window as any).__chromaticHeroCleanup as (() => void) | undefined;
    previousCleanup?.();

    const hero = document.querySelector<HTMLElement>("[data-dark-hero]");
    const portrait = document.querySelector<HTMLElement>("[data-chromatic-portrait]");
    const canvas = portrait?.querySelector<HTMLCanvasElement>(".hero-chromatic-canvas");
    const imageSrc = portrait?.dataset.imageSrc;
    const edgeSrc = portrait?.dataset.edgeSrc;
    const imageWidth = Number(portrait?.dataset.imageWidth);
    const imageHeight = Number(portrait?.dataset.imageHeight);
    const referenceImage = portrait?.querySelector<HTMLImageElement>("img");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    if (
      !hero ||
      !portrait ||
      !canvas ||
      !imageSrc ||
      !edgeSrc ||
      !referenceImage ||
      !Number.isFinite(imageWidth) ||
      !Number.isFinite(imageHeight) ||
      imageWidth < 1 ||
      imageHeight < 1 ||
      reduceMotion ||
      !finePointer
    ) {
      (window as any).__chromaticHeroCleanup = undefined;
      return;
    }

    const cleanup = initHeroChromaticWebGL({
      container: portrait,
      canvas,
      imageSrc,
      edgeSrc,
      hero,
      imageSize: [imageWidth, imageHeight],
      referenceImage,
    });

    (window as any).__chromaticHeroCleanup = cleanup ?? undefined;
  }

  function syncHeroTheme() {
    const hero = document.querySelector<HTMLElement>("[data-dark-hero]");
    const previous = (window as any).__heroThemeObserver as IntersectionObserver | undefined;
    previous?.disconnect();

    if (!hero) {
      document.body.classList.remove("hero-dark-active");
      return;
    }

    const updateTheme = () => {
      const rect = hero.getBoundingClientRect();
      document.body.classList.toggle(
        "hero-dark-active",
        rect.bottom > 70 && rect.top < window.innerHeight
      );
    };

    const observer = new IntersectionObserver(updateTheme, {
      rootMargin: "-70px 0px 0px",
      threshold: 0,
    });
    observer.observe(hero);
    (window as any).__heroThemeObserver = observer;
    updateTheme();
  }

  function setupDoorGate() {
    const previous = (window as any).__heroDoorGateCleanup as (() => void) | undefined;
    previous?.();
    (window as any).__heroDoorGateCleanup = initHeroDoorGate() ?? undefined;
  }

  initHero();
  initChromaticPortrait();
  syncHeroTheme();
  setupDoorGate();
  document.addEventListener("astro:page-load", () => {
    initHero();
    initChromaticPortrait();
    syncHeroTheme();
    setupDoorGate();
  });
  document.addEventListener("astro:before-swap", () => {
    const cleanup = (window as any).__heroDoorGateCleanup as (() => void) | undefined;
    cleanup?.();
    (window as any).__heroDoorGateCleanup = undefined;
  });
</script>
