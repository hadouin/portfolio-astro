---
import { Image, getImage } from "astro:assets";
import Link from "@components/ui/link.astro";
import { localizedPath, useTranslations, type Locale } from "@i18n/utils";
import heroPortrait from "@assets/hadouin-hero.jpg";
import heroEdges from "@assets/hadouin-hero-edges.webp";
import heroEdgesCompact from "@assets/hadouin-hero-edges-compact.webp";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const displayName = "Hadouin";
const heroTexture = await getImage({ src: heroPortrait, width: 1600, quality: 75, format: "webp" });
// Phones drive the same effect from the tilt sensor at a lower canvas DPR, so they
// get lighter textures instead of the multi-megabyte desktop pair.
const heroTextureCompact = await getImage({
  src: heroPortrait,
  width: 900,
  quality: 68,
  format: "webp",
});
---

<section
  class="hero-shell relative isolate z-30 -mt-[70px] min-h-[100svh] overflow-hidden"
  data-dark-hero
>
  <div
    class="hero-portrait absolute inset-x-0 top-0 h-[56%] md:inset-y-0 md:left-0 md:right-auto md:h-auto md:w-[58%]"
    data-chromatic-portrait
    data-image-src={heroTexture.src}
    data-edge-src={heroEdges.src}
    data-image-src-compact={heroTextureCompact.src}
    data-edge-src-compact={heroEdgesCompact.src}
    data-image-width={heroPortrait.width}
    data-image-height={heroPortrait.height}
  >
    <Image
      src={heroPortrait}
      alt={t("about.image.alt")}
      widths={[720, 1080, 1440, 1600]}
      sizes="(min-width: 768px) 58vw, 100vw"
      quality={68}
      loading="eager"
      fetchpriority="high"
      class="hero-portrait-image hero-portrait-base"
    />
    <canvas class="hero-chromatic-canvas" aria-hidden="true"></canvas>
  </div>

  <div
    class="hero-content relative z-10 mx-auto flex min-h-[100svh] w-full max-w-screen-2xl items-end px-4 pb-12 pt-[48vh] md:items-center md:justify-end md:px-6 md:pb-16 md:pt-[70px] lg:px-8"
  >
    <div class="w-full md:w-[56%] md:max-w-[50rem] lg:w-[54%]">
      <p class="hero-kicker mb-3 text-sm font-semibold uppercase tracking-[0.24em] md:text-base">
        {t("hero.greeting")}
      </p>
      <h1
        class="text-5xl font-bold tracking-wide sm:text-6xl lg:text-7xl xl:text-8xl"
        aria-label="Hadouin Leroy"
      >
        <span class="sr-only">Hadouin Leroy</span>
        <span
          class="hacker-effect block h-[48px] whitespace-pre sm:h-[60px] lg:h-[72px] xl:h-[96px]"
          data-value={displayName}
          aria-hidden="true"
        >
          {displayName}
        </span>
      </h1>
      <p class="hero-tagline mt-2 max-w-3xl text-3xl font-bold leading-[0.98] sm:text-4xl lg:text-5xl xl:text-6xl">
        {t("hero.tagline")}
      </p>
      <p class="hero-intro my-6 max-w-2xl font-inter text-base leading-relaxed sm:text-lg">
        {t("hero.intro")}
      </p>
      <Link
        class="hire-me wiggle w-fit font-semibold"
        style="inverted"
        href={localizedPath("/contact", locale)}
      >
        {t("nav.hireMe")}
      </Link>
    </div>
  </div>

  <div class="hero-grain pointer-events-none absolute inset-0 z-20" aria-hidden="true"></div>
</section>

<style>
  .hero-shell {
    background: #1a1a19;
    color: #f4f4f0;
  }

  .hero-portrait {
    isolation: isolate;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 70%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 70%, transparent 100%);
  }

  .hero-portrait-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 43%;
  }

  .hero-portrait-base {
    z-index: 0;
  }

  .hero-chromatic-canvas {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
  }

  .hero-portrait[data-chromatic-ready="true"] .hero-chromatic-canvas {
    opacity: 1;
  }

  .hero-portrait[data-chromatic-ready="true"] .hero-portrait-base {
    visibility: hidden;
  }

  .hero-portrait::after {
    position: absolute;
    z-index: 2;
    inset: 0;
    content: "";
    background:
      linear-gradient(to bottom, transparent 48%, #1a1a19 100%),
      linear-gradient(to right, transparent 62%, rgb(26 26 25 / 0.42) 100%);
    pointer-events: none;
  }

  .hero-kicker {
    color: #c7c7c0;
  }

  .hero-tagline {
    color: #a8a8a2;
    text-wrap: balance;
  }

  .hero-intro {
    color: #deded8;
  }

  .hero-grain {
    opacity: 0.04;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  @media (min-width: 768px) {
    .hero-portrait {
      -webkit-mask-image: linear-gradient(to right, #000 0%, #000 58%, transparent 100%);
      mask-image: linear-gradient(to right, #000 0%, #000 58%, transparent 100%);
    }

    .hero-portrait::after {
      background:
        linear-gradient(to right, transparent 54%, #1a1a19 100%),
        linear-gradient(to top, rgb(26 26 25 / 0.18), transparent 38%);
    }

    .hero-portrait-image {
      object-position: 50% 48%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-chromatic-canvas {
      display: none;
    }
  }
</style>

<script>
  import {
    initHeroChromaticWebGL,
    type HeroChromaticDebug,
  } from "../lib/hero-chromatic-webgl";

  const letters = "abcdefgHijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ?@:/}{()*+-#$&?@:/}{()*+-#$&";
  const scrambleColors = ["#8BA6F3", "#F0C477", "#EE8D8D"];
  const randomScrambleColor = () =>
    scrambleColors[Math.floor(Math.random() * scrambleColors.length)];

  function setScrambledContent(element: HTMLElement, target: string, iteration: number) {
    element.replaceChildren();
    for (let index = 0; index < target.length; index++) {
      const ch = target[index];
      if (index < iteration) {
        element.appendChild(document.createTextNode(ch));
        continue;
      }
      const span = document.createElement("span");
      span.style.color = randomScrambleColor();
      span.textContent = letters[Math.floor(Math.random() * letters.length)];
      element.appendChild(span);
    }
  }

  function initHero() {
    const element = document.querySelector(".hacker-effect") as HTMLElement | null;
    if (!element) return;
    if ((element as any).__heroBound) return;
    (element as any).__heroBound = true;

    const target = element.dataset.value ?? "Hadouin";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let interval: ReturnType<typeof setInterval> | undefined;

    const scramble = () => {
      if (reduceMotion) {
        element.textContent = target;
        return;
      }

      if (interval) clearInterval(interval);
      let iteration = 0;
      interval = setInterval(() => {
        setScrambledContent(element, target, iteration);

        if (iteration >= target.length) {
          if (interval) clearInterval(interval);
          element.textContent = target;
        }
        iteration += 1 / 3;
      }, 30);
    };

    element.addEventListener("mouseenter", scramble);
    scramble();
  }

  // The tilt readout has to be usable on a real phone against a real build, so it
  // is gated on a #dev hash rather than on the dev server.
  const debugRequested = () => window.location.hash.toLowerCase().startsWith("#dev");
  let debugPanelActive = false;

  function initTiltDebugPanel(hero: HTMLElement) {
    hero.querySelector(".hero-tilt-debug")?.remove();

    const panel = document.createElement("pre");
    panel.className = "hero-tilt-debug";
    panel.setAttribute("aria-hidden", "true");
    panel.style.cssText = [
      "position:absolute",
      "left:12px",
      "bottom:12px",
      "z-index:40",
      "margin:0",
      "padding:8px 10px",
      "border-radius:6px",
      "background:rgb(12 12 11 / 0.72)",
      "color:#deded8",
      "font:11px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace",
      "white-space:pre",
      "pointer-events:none",
      "backdrop-filter:blur(4px)",
    ].join(";");
    hero.appendChild(panel);

    const num = (value: number | null | undefined, digits = 2) =>
      value === null || value === undefined || Number.isNaN(value)
        ? "  —".padStart(digits + 4)
        : value.toFixed(digits).padStart(digits + 4);

    return (debug: HeroChromaticDebug | string) => {
      if (typeof debug === "string") {
        panel.textContent = `tilt   effect off · ${debug}`;
        return;
      }

      const { tilt } = debug;
      const sensor = tilt
        ? `${tilt.status} · ${tilt.events} evt${
            tilt.status === "awaiting-gesture" ? " · tap hero to allow" : ""
          }${tilt.status === "listening" && tilt.events === 0 ? " · no sensor data" : ""}`
        : "no sensor";

      panel.textContent = [
        `tilt   ${sensor}`,
        tilt
          ? `raw    b${num(tilt.raw.beta, 1)}  g${num(tilt.raw.gamma, 1)}  a${num(tilt.raw.alpha, 1)}`
          : "raw    —",
        tilt
          ? `screen ${tilt.screenAngle}deg  neutral${num(tilt.neutral?.x, 1)} /${num(tilt.neutral?.y, 1)}`
          : "screen —",
        tilt ? `sample x${num(tilt.sample.x)}  y${num(tilt.sample.y)}` : "sample —",
        `focus  x${num(debug.focus[0])}  y${num(debug.focus[1])}`,
        `drive  vel${num(debug.velocity[0], 3)} /${num(debug.velocity[1], 3)}  int${num(debug.intensity)}`,
        `source ${debug.source}`,
      ].join("\n");
    };
  }

  function initChromaticPortrait() {
    const previousCleanup = (window as any).__chromaticHeroCleanup as (() => void) | undefined;
    previousCleanup?.();
    document.querySelector(".hero-tilt-debug")?.remove();
    debugPanelActive = debugRequested();

    const hero = document.querySelector<HTMLElement>("[data-dark-hero]");
    const portrait = document.querySelector<HTMLElement>("[data-chromatic-portrait]");
    const canvas = portrait?.querySelector<HTMLCanvasElement>(".hero-chromatic-canvas");
    const compact = window.matchMedia("(max-width: 767px)").matches;
    const imageSrc = (compact && portrait?.dataset.imageSrcCompact) || portrait?.dataset.imageSrc;
    const edgeSrc = (compact && portrait?.dataset.edgeSrcCompact) || portrait?.dataset.edgeSrc;
    const imageWidth = Number(portrait?.dataset.imageWidth);
    const imageHeight = Number(portrait?.dataset.imageHeight);
    const referenceImage = portrait?.querySelector<HTMLImageElement>("img");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    // Touch devices get the same effect, driven by the orientation sensor instead.
    const hasTiltSensor = typeof (window as any).DeviceOrientationEvent !== "undefined";

    const missingAssets =
      !portrait ||
      !canvas ||
      !imageSrc ||
      !edgeSrc ||
      !referenceImage ||
      !Number.isFinite(imageWidth) ||
      !Number.isFinite(imageHeight) ||
      imageWidth < 1 ||
      imageHeight < 1;

    if (!hero || missingAssets || reduceMotion || (!finePointer && !hasTiltSensor)) {
      (window as any).__chromaticHeroCleanup = undefined;
      if (debugPanelActive && hero) {
        initTiltDebugPanel(hero)(
          missingAssets ? "missing assets" : reduceMotion ? "reduce-motion" : "no input source"
        );
      }
      return;
    }

    const renderDebug = debugPanelActive ? initTiltDebugPanel(hero) : undefined;

    // Hold the first-load preloader until the hero textures are in cache, so
    // the reveal never lands on an un-rendered portrait. No-op after first load.
    const loader = (window as any).hadouinLoader;
    if (loader && "loading" in document.documentElement.dataset) {
      loader.register(
        Promise.all(
          [imageSrc, edgeSrc].map(
            (src) =>
              new Promise<void>((resolve) => {
                const preload = new window.Image();
                preload.onload = () => resolve();
                preload.onerror = () => resolve();
                preload.src = src;
              })
          )
        )
      );
    }

    const cleanup = initHeroChromaticWebGL({
      container: portrait,
      canvas,
      imageSrc,
      edgeSrc,
      hero,
      imageSize: [imageWidth, imageHeight],
      referenceImage,
      onDebug: renderDebug,
    });

    (window as any).__chromaticHeroCleanup = cleanup ?? undefined;
  }

  function syncHeroTheme() {
    const hero = document.querySelector<HTMLElement>("[data-dark-hero]");
    const previous = (window as any).__heroThemeObserver as IntersectionObserver | undefined;
    previous?.disconnect();

    if (!hero) {
      document.body.classList.remove("hero-dark-active");
      return;
    }

    const updateTheme = () => {
      const rect = hero.getBoundingClientRect();
      document.body.classList.toggle(
        "hero-dark-active",
        rect.bottom > 70 && rect.top < window.innerHeight
      );
    };

    const observer = new IntersectionObserver(updateTheme, {
      rootMargin: "-70px 0px 0px",
      threshold: 0,
    });
    observer.observe(hero);
    (window as any).__heroThemeObserver = observer;
    updateTheme();
  }

  // Toggling #dev on or off rebuilds the effect so the readout can attach or detach.
  window.addEventListener("hashchange", () => {
    if (debugRequested() !== debugPanelActive) initChromaticPortrait();
  });

  initHero();
  initChromaticPortrait();
  syncHeroTheme();
  document.addEventListener("astro:page-load", () => {
    initHero();
    initChromaticPortrait();
    syncHeroTheme();
  });
</script>
