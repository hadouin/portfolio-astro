---
/**
 * First-load preloader. Splits the H logo into two halves that converge while
 * real page assets download, then wipes upward to reveal the page.
 *
 * Progress is driven by actual work, not a fixed timer: eager images, webfonts,
 * `window.load`, and any long-running task a component registers (the hero WebGL
 * textures today, 3D scenes later) via `window.hadouinLoader.register(promise)`.
 *
 * Shown once per session, on the initial full page load only. Skipped for
 * reduced-motion and for ClientRouter navigations (sessionStorage flag).
 * The gate script is the first node in <body> so it runs before any content
 * paints — no flash either way.
 */
const LOGO_PATH =
  "M423.381 0L344.061 376.5H224.881L248.235 263.653H142.898L119.163 376.5H0L79.3199 0H198.37L164.089 165.174H270.05L304.331 0H423.381Z";
---

<script is:inline>
  (() => {
    // Registered before anything else so component scripts further down the
    // document can always hand the loader a task to wait on.
    const tasks = [];
    window.hadouinLoader = {
      register(task) {
        const p = typeof task === "function" ? Promise.resolve().then(task) : task;
        tasks.push(Promise.resolve(p).catch(() => {}));
        return p;
      },
      _tasks: tasks,
    };

    try {
      const seen = sessionStorage.getItem("hadouin:loader-seen");
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!seen && !reduce) document.documentElement.dataset.loading = "";
    } catch {
      /* storage blocked — skip the loader rather than risk trapping the page */
    }
  })();
</script>

<div id="site-loader" aria-hidden="true">
  <div class="loader-logo">
    <div class="loader-half loader-half--l">
      <div class="loader-half-inner">
        <svg viewBox="0 0 424 377" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d={LOGO_PATH} fill="currentColor" />
        </svg>
      </div>
    </div>
    <div class="loader-half loader-half--r">
      <div class="loader-half-inner">
        <svg viewBox="0 0 424 377" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d={LOGO_PATH} fill="currentColor" />
        </svg>
      </div>
    </div>
  </div>
  <div class="loader-meta">
    <div class="loader-bar"><span></span></div>
    <div class="loader-pct">0</div>
  </div>
</div>

<style is:inline>
  #site-loader {
    display: none;
  }

  html[data-loading] {
    overflow: hidden;
    /* Match the loader panel so there is no white flash before it paints. */
    background-color: #1a1a19;
  }

  html[data-loading] #site-loader {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 100;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    background-color: #1a1a19;
    clip-path: inset(0 0 0 0);
    will-change: clip-path;
  }

  #site-loader .loader-logo {
    position: relative;
    width: 96px;
    height: 85px; /* 96 * 377/424, preserves the logo aspect ratio */
    color: #faf9f6;
  }

  @media (min-width: 768px) {
    #site-loader .loader-logo {
      width: 132px;
      height: 117px;
    }
  }

  #site-loader .loader-half {
    position: absolute;
    inset: 0;
  }

  /* Clip lives on the wrapper so it stays put while the inner half slides. */
  #site-loader .loader-half--l {
    clip-path: inset(0 50% 0 0);
  }

  #site-loader .loader-half--r {
    clip-path: inset(0 0 0 50%);
  }

  #site-loader .loader-half-inner {
    width: 100%;
    height: 100%;
    will-change: transform, opacity;
  }

  #site-loader .loader-half-inner svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #site-loader .loader-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  #site-loader .loader-bar {
    position: relative;
    width: 96px;
    height: 1px;
    overflow: hidden;
    background-color: rgba(250, 249, 246, 0.18);
  }

  @media (min-width: 768px) {
    #site-loader .loader-bar {
      width: 132px;
    }
  }

  #site-loader .loader-bar span {
    display: block;
    width: 100%;
    height: 100%;
    background-color: #faf9f6;
    transform: scaleX(0);
    transform-origin: left center;
    /* Driven by real progress from the script below. */
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  #site-loader .loader-pct {
    min-width: 3ch;
    font-size: 11px;
    letter-spacing: 0.12em;
    font-variant-numeric: tabular-nums;
    color: rgba(250, 249, 246, 0.55);
  }

  /* --- entrance: halves converge --- */
  html[data-loading] .loader-half--l .loader-half-inner {
    animation: loaderConvergeUp 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  html[data-loading] .loader-half--r .loader-half-inner {
    animation: loaderConvergeDown 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  html[data-loading] .loader-meta {
    animation: loaderMetaIn 520ms 260ms ease-out both;
  }

  @keyframes loaderConvergeUp {
    from {
      opacity: 0;
      transform: translateY(64%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes loaderConvergeDown {
    from {
      opacity: 0;
      transform: translateY(-64%);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes loaderMetaIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* --- exit: logo lifts away, panel wipes upward --- */
  html[data-loading-exit] #site-loader {
    animation: loaderWipeUp 680ms 140ms cubic-bezier(0.76, 0, 0.24, 1) both;
  }

  html[data-loading-exit] #site-loader .loader-logo,
  html[data-loading-exit] #site-loader .loader-meta {
    animation: loaderLift 520ms cubic-bezier(0.55, 0, 1, 0.45) both;
  }

  @keyframes loaderWipeUp {
    from {
      clip-path: inset(0 0 0 0);
    }
    to {
      clip-path: inset(0 0 100% 0);
    }
  }

  @keyframes loaderLift {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-28px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #site-loader {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    if (!("loading" in root.dataset)) return;

    const MIN_MS = 900; // let the convergence land before we can exit
    const MAX_MS = 9000; // never hold the page hostage on a stalled asset
    const EXIT_MS = 900; // must outlast the wipe + its delay

    const started = performance.now();
    const bar = document.querySelector("#site-loader .loader-bar span");
    const pct = document.querySelector("#site-loader .loader-pct");

    let total = 0;
    let done = 0;
    let shown = 0;
    let finished = false;

    const paint = () => {
      // Never let the bar retreat if late tasks enlarge the denominator.
      const ratio = total === 0 ? 1 : done / total;
      shown = Math.max(shown, ratio);
      if (bar) bar.style.transform = "scaleX(" + shown + ")";
      if (pct) pct.textContent = String(Math.round(shown * 100));
    };

    const track = (promise) => {
      total += 1;
      Promise.resolve(promise)
        .catch(() => {})
        .then(() => {
          done += 1;
          paint();
        });
    };

    // An <img> counts as loaded once decoded, so the reveal never lands on a
    // half-painted hero. Broken/aborted images resolve rather than block.
    const trackImage = (img) => {
      if (img.loading === "lazy") return; // below the fold, not worth waiting on
      track(
        new Promise((resolve) => {
          if (img.complete && img.naturalWidth > 0) {
            img.decode().then(resolve, resolve);
            return;
          }
          img.addEventListener("load", () => img.decode().then(resolve, resolve), { once: true });
          img.addEventListener("error", resolve, { once: true });
        })
      );
    };

    const finish = () => {
      if (finished) return;
      finished = true;
      shown = 1;
      paint();
      try {
        sessionStorage.setItem("hadouin:loader-seen", "1");
      } catch {
        /* storage blocked — loader simply replays next load */
      }
      root.dataset.loadingExit = "";
      setTimeout(() => {
        delete root.dataset.loading;
        delete root.dataset.loadingExit;
        const lenis = window.lenis;
        if (lenis) {
          lenis.resize();
          lenis.start();
        }
        document.dispatchEvent(new CustomEvent("hadouin:loader-done"));
      }, EXIT_MS);
    };

    let trackedRegistered = 0;

    const drainRegistered = () => {
      const registered = window.hadouinLoader ? window.hadouinLoader._tasks : [];
      for (let i = trackedRegistered; i < registered.length; i += 1) track(registered[i]);
      trackedRegistered = registered.length;
    };

    // Poll rather than racing a single allSettled, so work registered late
    // (a 3D scene booting after `load`) still gates the exit.
    const tick = () => {
      if (finished) return;
      drainRegistered();
      if (total > 0 && done >= total) {
        const elapsed = performance.now() - started;
        setTimeout(finish, Math.max(0, MIN_MS - elapsed));
        return;
      }
      requestAnimationFrame(tick);
    };

    const start = () => {
      document.querySelectorAll("img").forEach(trackImage);
      if (document.fonts && document.fonts.ready) track(document.fonts.ready);
      track(
        document.readyState === "complete"
          ? Promise.resolve()
          : new Promise((r) => window.addEventListener("load", r, { once: true }))
      );
      drainRegistered();
      paint();
      requestAnimationFrame(tick);
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", start, { once: true });
    } else {
      start();
    }

    setTimeout(finish, MAX_MS);
  })();
</script>
