---
import { useTranslations, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const facts = [
  { label: t("glance.who.label"), value: t("glance.who.value") },
  { label: t("glance.what.label"), value: t("glance.what.value") },
  { label: t("glance.now.label"), value: t("glance.now.value") },
  { label: t("glance.where.label"), value: t("glance.where.value") },
  { label: t("glance.contact.label"), value: t("glance.contact.value") },
];
---

<section
  hidden
  aria-hidden="true"
  data-agent-context="at-a-glance"
  aria-labelledby="at-a-glance-heading"
>
  <h2 id="at-a-glance-heading">{t("glance.title")}</h2>
  <dl>
    {
      facts.map(({ label, value }) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
  </dl>
</section>
