---
import About from "@components/about.astro";
import AtAGlance from "@components/at-a-glance.astro";
import Container from "@components/container.astro";
import Cta from "@components/cta.astro";
import Education from "@components/education.astro";
import Experience from "@components/experience.astro";
import FactoryScene from "@components/factory-scene.astro";
import Hero from "@components/hero.astro";
import Projects from "@components/projects.astro";
import Layout from "@layouts/Layout.astro";
import { getExperiences } from "@i18n/data";
import { localizedPath, useTranslations, type Locale } from "@i18n/utils";
import { getCollection } from "astro:content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const experiences = getExperiences(locale);

const siteUrl = Astro.site?.toString() ?? "https://hadouin.com";

const featuredProjects = await getCollection(
  "portfolio",
  ({ id, data }) =>
    id.startsWith(`${locale}/`) && !data.draft && data.show !== false,
);
featuredProjects.sort(
  (a, b) => (a.data.priority ?? 999) - (b.data.priority ?? 999),
);
const workExamples = featuredProjects.slice(0, 4).map((entry) => {
  const slug = entry.id.replace(/^(en|fr)\//, "").replace(/\.md$/, "");
  return {
    "@type": "CreativeWork" as const,
    name: entry.data.title,
    url: new URL(localizedPath(`/projects/${slug}`, locale), siteUrl).toString(),
  };
});

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Hadouin Leroy",
  givenName: "Hadouin",
  familyName: "Leroy",
  url: siteUrl,
  image: new URL("/opengraph.png", siteUrl).toString(),
  jobTitle: "Founding Engineer",
  description: t("person.schemaDescription"),
  email: "mailto:contact@hadouin.com",
  nationality: { "@type": "Country", name: "France" },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Paris",
    addressCountry: "FR",
  },
  worksFor: {
    "@type": "Organization",
    name: "Runelabs",
  },
  hasOccupation: experiences.map((exp) => ({
    "@type": "Occupation",
    name: exp.role,
    occupationalCategory: exp.context,
    worksFor: {
      "@type": "Organization",
      name: exp.company,
    },
  })),
  workExample: workExamples,
  alumniOf: [
    {
      "@type": "CollegeOrUniversity",
      name: "ISEP — Institut Supérieur d'Électronique de Paris",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Wrexham Glyndwr University",
    },
    {
      "@type": "CollegeOrUniversity",
      name: "Presidency University, Bangalore",
    },
  ],
  knowsAbout: [
    "Creative development",
    "Web development",
    "Game development",
    "Blender",
    "Three.js",
    "React",
    "Astro",
    "Dojo",
    "Starknet",
    "UX design",
    "Scrum",
  ],
  knowsLanguage: [
    { "@type": "Language", name: "French", alternateName: "fr" },
    { "@type": "Language", name: "English", alternateName: "en" },
  ],
  sameAs: [
    "https://github.com/hadouin",
    "https://www.linkedin.com/in/hadouin",
    "https://twitter.com/hadouin",
  ],
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  url: siteUrl,
  name: "Hadouin Leroy",
  description: t("site.description"),
  author: { "@type": "Person", name: "Hadouin Leroy" },
  inLanguage: locale === "fr" ? "fr-FR" : "en-US",
};

const keywords =
  locale === "fr"
    ? [
        "Hadouin Leroy",
        "développeur créatif",
        "creative developer",
        "creative dev freelance",
        "freelance Paris",
        "portfolio",
        "Paris",
        "développeur web",
        "développeur de jeux",
        "Blender",
        "Three.js",
        "Astro",
        "React",
        "Dojo",
        "Starknet",
        "UX designer",
        "Scrum Master",
        "Runelabs",
      ]
    : [
        "Hadouin Leroy",
        "creative developer",
        "creative dev freelance",
        "freelance creative dev",
        "portfolio",
        "Paris",
        "game developer",
        "Blender",
        "Three.js",
        "Astro",
        "React",
        "Dojo",
        "Starknet",
        "UX designer",
        "Scrum Master",
        "Runelabs",
      ];
---

<Layout locale={locale} description={t("site.description")} keywords={keywords}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(personJsonLd)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(websiteJsonLd)}
  />
  <Hero locale={locale} />
  <FactoryScene />
  <div class="relative z-10 bg-white">
    <Container>
      <AtAGlance locale={locale} />
      <About locale={locale} />
      <Experience locale={locale} />
      <Education locale={locale} />
      <Projects locale={locale} />
      <Cta locale={locale} />
    </Container>
  </div>
</Layout>
