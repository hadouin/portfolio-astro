---
import { useTranslations, type Locale } from "@i18n/utils";
import { getExperiences } from "@i18n/data";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const experiences = getExperiences(locale);
---

<section id="experience" class="mb-24 mt-16">
  <h2 class="text-4xl font-bold">{t("experience.title")}</h2>
  <h3 class="text-lg text-slate-700 mb-8">{t("experience.subtitle")}</h3>

  <ol class="space-y-12">
    {
      experiences.map((exp) => (
        <li class="grid lg:grid-cols-12 gap-x-4 lg:gap-8 gap-y-1">
          <div class="lg:col-span-3">
            <p class="font-inter text-sm text-slate-500">{exp.period}</p>
          </div>
          <div class="lg:col-span-9">
            <h3 class="text-2xl font-bold">
              {exp.role}
              <span class="text-slate-500"> @ {exp.company}</span>
            </h3>
            <p class="font-inter text-sm text-slate-500 mb-3">{exp.context}</p>
            <ul class="space-y-2">
              {exp.bullets.map((b) => (
                <li class="font-inter leading-relaxed flex gap-3">
                  <span class="text-slate-400 shrink-0">▹</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
            <ul class="flex flex-wrap gap-2 mt-4">
              {exp.skills.map((s) => (
                <li class="font-inter text-xs border border-slate-300 rounded-full px-3 py-1">
                  {s}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>
