---
import { useTranslations, type Locale } from "@i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const paragraphs = [t("about.p1"), t("about.p2"), t("about.p3")];
---

<section class="about-section mb-16 bg-white pt-24 lg:pt-32 relative z-10" id="about">
  <div class="text max-w-3xl">
    <h2 class="text-2xl font-bold">{t("about.title")}</h2>
    {paragraphs.map((item) => <p class="font-inter my-2">{item}</p>)}
  </div>
</section>

<style>
  .about-section {
    background-color: #ffffff;
  }

  ul.tech-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(140px, 200px));
    gap: 0px 10px;
    padding: 0px;
    margin: 20px 0px 0px;
    overflow: hidden;
    list-style: none;
  }
  .tech-list li {
    position: relative;
    margin-bottom: 10px;
    padding-left: 20px;
    font-family: monospace;
  }

  .tech-list li::before {
    content: "▹";
    position: absolute;
    left: 0px;
    bottom: 0;
    line-height: 12px;
  }
</style>
