---
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import {
  defaultLocale,
  getLocaleFromUrl,
  localizedPath,
  stripLocaleFromPath,
  useTranslations,
  type Locale,
} from "@i18n/utils";
import { htmlLangTag, locales, ogLocaleTag } from "@i18n/ui";
import "@fontsource/inter/variable.css";
import "lenis/dist/lenis.css";

import "assets/styles/base.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  keywords?: string[];
  noindex?: boolean;
  locale?: Locale;
  /** Disable hreflang alternates emission. Used by single-locale pages (e.g. /signature). */
  noAlternates?: boolean;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
}

const SITE_NAME = "Hadouin Leroy";
const TWITTER_HANDLE = "@hadouin";
const analyticsDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;

const {
  title,
  description,
  image = "/opengraph.png",
  imageAlt,
  keywords,
  noindex = false,
  locale: localeProp,
  noAlternates = false,
  article,
} = Astro.props;

const locale: Locale = localeProp ?? getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const resolvedDescription = description ?? t("site.description");
const resolvedImageAlt = imageAlt ?? t("site.image.alt");

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const basePath = stripLocaleFromPath(Astro.url.pathname);
const alternates = noAlternates
  ? []
  : locales.map((loc) => ({
      hreflang: loc,
      href: new URL(localizedPath(basePath, loc), Astro.site).toString(),
    }));
const xDefaultHref = noAlternates
  ? null
  : new URL(localizedPath(basePath, defaultLocale), Astro.site).toString();

const alternateOgLocales = locales
  .filter((loc) => loc !== locale)
  .map((loc) => ogLocaleTag[loc]);

const resolvedImageWithDomain = new URL(image, Astro.site).toString();

const makeTitle = title
  ? title + " | " + SITE_NAME
  : t("site.title.fallback");

const openGraph = article
  ? {
      basic: {
        url: canonicalURL,
        type: "article",
        title: makeTitle,
        image: resolvedImageWithDomain,
      },
      image: { alt: resolvedImageAlt },
      article: {
        publishedTime: article.publishedTime,
        modifiedTime: article.modifiedTime,
        authors: article.author ? [article.author] : undefined,
        section: article.section,
        tags: article.tags,
      },
    }
  : {
      basic: {
        url: canonicalURL,
        type: "website",
        title: makeTitle,
        image: resolvedImageWithDomain,
      },
      image: { alt: resolvedImageAlt },
    };
---

<!DOCTYPE html>
<html lang={htmlLangTag[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#333333" />
    <meta name="msapplication-TileColor" content="#ffc40d" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Hadouin Leroy" />
    {keywords && keywords.length > 0 && (
      <meta name="keywords" content={keywords.join(", ")} />
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM site summary" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} — Blog`}
      href="/rss.xml"
    />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {xDefaultHref && (
      <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    )}
    {
      analyticsDomain && (
        <script
          defer
          data-domain={analyticsDomain}
          src="https://plausible.io/js/script.js"
        />
      )
    }

    <ClientRouter />
    <SEO
      title={makeTitle}
      description={resolvedDescription}
      canonical={canonicalURL}
      noindex={noindex}
      nofollow={noindex}
      openGraph={openGraph}
      twitter={{
        card: "summary_large_image",
        creator: TWITTER_HANDLE,
        site: TWITTER_HANDLE,
        title: makeTitle,
        description: resolvedDescription,
        image: resolvedImageWithDomain,
        imageAlt: resolvedImageAlt,
      }}
      extend={{
        meta: [
          { name: "robots", content: noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large" },
          { property: "og:site_name", content: SITE_NAME },
          { property: "og:locale", content: ogLocaleTag[locale] },
          ...alternateOgLocales.map((altLocale) => ({
            property: "og:locale:alternate",
            content: altLocale,
          })),
        ],
      }}
    />
    <slot name="head" />
  </head>
  <body>
    <Navbar locale={locale} />
    <div
      class="side-rail hidden xl:flex fixed bottom-0 w-10 items-center justify-center flex-col right-10 left-auto after:h-20 after:w-px after:bg-slate-500">
      <div class="email-sidelink my-5">
        <a
          class="relative no-underline tracking-widest"
          href="mailto:contact@hadouin.com"
          >contact@hadouin.com
        </a>
      </div>
    </div>
    <div
      class="side-rail hidden xl:flex fixed bottom-0 w-10 items-center justify-center flex-col left-10 right-auto after:h-20 after:w-px after:bg-slate-500">
      <ul
        class="socials-side flex flex-col justify-center items-center list-none text-slate-700">
        <li class="mb-3">
          <a
            class="flex p-2 transition"
            href="https://github.com/hadouin"
            target="_blank"
            rel="noopener noreferrer">
            <svg class="feather">
              <use href="/feather-sprite.svg#github"></use>
            </svg>
          </a>
        </li>
        <li class="mb-3">
          <a
            class="flex p-2 transition"
            href="https://www.linkedin.com/in/hadouin"
            target="_blank"
            rel="noopener noreferrer">
            <svg class="feather">
              <use href="/feather-sprite.svg#linkedin"></use>
            </svg>
          </a>
        </li>
      </ul>
    </div>
    <div class="pt-[70px]">
      <slot />
    </div>
    <Footer locale={locale} />
    <script>
      import Lenis from "lenis";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const lenis = reduceMotion
        ? null
        : new Lenis({
            autoRaf: true,
            anchors: true,
          });
      if (lenis) (window as any).lenis = lenis;

      let parallaxIO: IntersectionObserver | null = null;
      let scrollHandler: (() => void) | null = null;

      const scrambleLetters =
        "abcdefgHijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ?@:/}{()*+-#$&";
      const scrambleColors = ["#8BA6F3", "#F0C477", "#EE8D8D"];
      const randomScrambleChar = () =>
        scrambleLetters[Math.floor(Math.random() * scrambleLetters.length)];
      const randomScrambleColor = () =>
        scrambleColors[Math.floor(Math.random() * scrambleColors.length)];

      function setScrambledContent(
        el: HTMLElement,
        target: string,
        iteration: number
      ) {
        el.replaceChildren();
        for (let index = 0; index < target.length; index++) {
          const ch = target[index];
          if (ch === " ") {
            el.appendChild(document.createTextNode(" "));
            continue;
          }
          if (index < iteration) {
            el.appendChild(document.createTextNode(ch));
            continue;
          }
          const span = document.createElement("span");
          span.style.color = randomScrambleColor();
          span.textContent = randomScrambleChar();
          el.appendChild(span);
        }
      }

      function bindPage() {
        document.querySelectorAll<HTMLElement>(".watermark-hover").forEach((el) => {
          if ((el as any).__watermarkBound) return;
          (el as any).__watermarkBound = true;
          el.addEventListener("mouseenter", () => {
            el.classList.remove("is-scan-out");
            el.classList.add("is-scan-in");
          });
          el.addEventListener("mouseleave", () => {
            el.classList.remove("is-scan-in");
            el.classList.add("is-scan-out");
          });
        });

        document
          .querySelectorAll<HTMLElement>(".scramble-hover")
          .forEach((el) => {
            if ((el as any).__scrambleBound) return;
            (el as any).__scrambleBound = true;
            const target = (el.dataset.scrambleText ?? el.textContent ?? "").trim();
            if (!target) return;
            el.dataset.scrambleText = target;
            let interval: ReturnType<typeof setInterval> | undefined;

            el.addEventListener("mouseenter", () => {
              if (interval) clearInterval(interval);
              let iteration = 0;
              const tickMs = 30;
              const durationMs = 300;
              const step = target.length / (durationMs / tickMs);

              interval = setInterval(() => {
                setScrambledContent(el, target, iteration);

                if (iteration >= target.length) {
                  if (interval) clearInterval(interval);
                  el.textContent = target;
                }
                iteration += step;
              }, tickMs);
            });
          });

        if (parallaxIO) parallaxIO.disconnect();
        if (scrollHandler && lenis) lenis.off("scroll", scrollHandler);

        const isMobile = window.matchMedia("(max-width: 767px)").matches;
        if (reduceMotion || isMobile) return;

        const parallaxEls = Array.from(
          document.querySelectorAll<HTMLElement>("[data-parallax]")
        );
        const visible = new Set<HTMLElement>();
        parallaxIO = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const t = e.target as HTMLElement;
              if (e.isIntersecting) visible.add(t);
              else {
                visible.delete(t);
                t.style.transform = "";
              }
            }
          },
          { rootMargin: "20% 0px 20% 0px" }
        );
        parallaxEls.forEach((el) => {
          el.style.willChange = "transform";
          {
            const vh = window.innerHeight;
            const speed = parseFloat(el.dataset.parallax || "0.05");
            const scale = parseFloat(el.dataset.parallaxScale || "1.08");
            const rect = el.getBoundingClientRect();
            const ec = rect.top + rect.height / 2;
            const offset = (vh / 2 - ec) * speed;
            el.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0) scale(${scale})`;
          }
          parallaxIO!.observe(el);
        });

        const update = () => {
          const vh = window.innerHeight;
          const vc = vh / 2;
          visible.forEach((el) => {
            const speed = parseFloat(el.dataset.parallax || "0.05");
            const scale = parseFloat(el.dataset.parallaxScale || "1.08");
            const rect = el.getBoundingClientRect();
            const ec = rect.top + rect.height / 2;
            const offset = (vc - ec) * speed;
            el.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0) scale(${scale})`;
          });
        };
        scrollHandler = update;
        if (lenis) {
          lenis.on("scroll", update);
          requestAnimationFrame(() => {
            update();
            requestAnimationFrame(update);
          });
        }
      }

      function syncScroll(y: number) {
        if (lenis) {
          lenis.scrollTo(y, { immediate: true, force: true });
          lenis.resize();
        }
        window.scrollTo(0, y);
      }

      function paintParallax() {
        if (window.matchMedia("(max-width: 767px)").matches) return;
        const vh = window.innerHeight;
        const vc = vh / 2;
        document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((el) => {
          const speed = parseFloat(el.dataset.parallax || "0.05");
          const scale = parseFloat(el.dataset.parallaxScale || "1.08");
          const rect = el.getBoundingClientRect();
          const ec = rect.top + rect.height / 2;
          const offset = (vc - ec) * speed;
          el.style.willChange = "transform";
          el.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0) scale(${scale})`;
        });
      }

      const SCROLL_KEY_PREFIX = "hadouin:scroll:";

      document.addEventListener("astro:before-preparation", () => {
        sessionStorage.setItem(
          SCROLL_KEY_PREFIX + location.pathname,
          String(window.scrollY)
        );
        if (location.pathname.startsWith("/projects/")) {
          syncScroll(0);
          paintParallax();
        }
      });

      document.addEventListener("astro:after-swap", () => {
        if (location.pathname.startsWith("/projects/")) {
          syncScroll(0);
        } else {
          let y = 0;
          if (location.hash) {
            try {
              const target = document.querySelector(location.hash) as HTMLElement | null;
              if (target) {
                const rect = target.getBoundingClientRect();
                const navOffset = 90;
                y = Math.max(0, Math.round(window.scrollY + rect.top - navOffset));
              }
            } catch {
              /* malformed hash — ignore */
            }
          }
          if (!y) {
            const saved = sessionStorage.getItem(SCROLL_KEY_PREFIX + location.pathname);
            y = saved ? parseInt(saved, 10) : 0;
          }
          syncScroll(y);
        }
        paintParallax();
      });

      function bindContinueReading() {
        const btn = document.getElementById("continue-reading");
        if (!btn) return;
        if (!location.pathname.startsWith("/projects/")) return;
        const key = SCROLL_KEY_PREFIX + location.pathname;
        const saved = sessionStorage.getItem(key);
        const y = saved ? parseInt(saved, 10) : 0;
        if (y <= 120) return;

        setTimeout(() => btn.classList.add("is-visible"), 720);

        const hide = () => btn.classList.remove("is-visible");
        btn.addEventListener("click", () => {
          hide();
          if (lenis) lenis.scrollTo(y, { duration: 1.0 });
          else window.scrollTo({ top: y, behavior: "smooth" });
          sessionStorage.removeItem(key);
        }, { once: true });

        const onScroll = () => {
          if (Math.abs(window.scrollY) > 40) {
            hide();
            window.removeEventListener("scroll", onScroll);
          }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
      }

      document.addEventListener("astro:page-load", () => {
        bindPage();
        bindContinueReading();
      });
    </script>
    <style is:global>
      html {
        scroll-padding-top: 70px; /* height of sticky header */
        background-color: #ffffff;
        transition: background-color 220ms ease;
      }

      html:has(body.hero-dark-active) {
        background-color: #1a1a19;
      }

      .navbar-root,
      .navbar-menu,
      .side-rail,
      .side-rail::after,
      .socials-side {
        transition:
          background-color 220ms ease,
          color 220ms ease,
          border-color 220ms ease;
      }

      body.hero-dark-active .side-rail,
      body.hero-dark-active .socials-side {
        color: #c7c7c0;
      }

      body.hero-dark-active .side-rail::after {
        background-color: #686863;
      }

      /* View Transitions: whiteout fade + smooth hero-image morph */
      @keyframes vt-fade-out {
        to { opacity: 0; }
      }
      @keyframes vt-fade-in {
        from { opacity: 0; }
      }

      ::view-transition-old(root) {
        animation: 320ms cubic-bezier(0.4, 0, 1, 1) both vt-fade-out;
      }
      ::view-transition-new(root) {
        animation: 320ms 280ms cubic-bezier(0, 0, 0.2, 1) both vt-fade-in;
      }

      ::view-transition-group(*) {
        animation-duration: 620ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        border-radius: 0.5rem;
        overflow: clip;
      }
      ::view-transition-image-pair(*) {
        isolation: auto;
        border-radius: 0.5rem;
      }
      ::view-transition-old(*),
      ::view-transition-new(*) {
        animation-duration: 620ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
        mix-blend-mode: normal;
        border-radius: 0.5rem;
      }
      ::view-transition-group(root),
      ::view-transition-image-pair(root),
      ::view-transition-old(root),
      ::view-transition-new(root) {
        border-radius: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation-duration: 1ms !important;
        }
      }
    </style>
    <style>
      .email-sidelink {
        writing-mode: vertical-lr;
      }

      .email-sidelink a::after {
        content: "";
        height: 100%;
        position: absolute;
        transform: scaleY(0);
        width: 2px;
        top: 0;
        left: 0;
        transform-origin: bottom left;
        transition: transform 0.25s ease-out;
      }

      .email-sidelink a:hover::after {
        transform: scaleX(1);
        transform-origin: top left;
      }
      .socials-side {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        list-style: none;
      }

      .socials-side li {
        margin-bottom: 12px;
      }

      .socials-side li a:hover {
        transform: scale(1.1);
      }
    </style>
  </body>
</html>
