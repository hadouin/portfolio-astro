---
import { getCollection } from "astro:content";
import ProjectDetail from "@components/project-detail.astro";

export async function getStaticPaths() {
  const enEntries = await getCollection("portfolio", ({ id, data }) => {
    return id.startsWith("en/") && !data.draft;
  });
  return enEntries.map((entry) => {
    const slug = entry.id.slice(3);
    return {
      params: { slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
---

<ProjectDetail locale="en" slug={slug} entry={entry} />
